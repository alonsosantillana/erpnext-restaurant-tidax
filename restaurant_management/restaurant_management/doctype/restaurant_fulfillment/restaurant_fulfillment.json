{
 "actions": [],
 "autoname": "naming_series:",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "naming_series",
  "order",
  "fulfillment_type",
  "status",
  "company",
  "pos_profile",
  "customer_section",
  "customer",
  "customer_name_snapshot",
  "contact_phone",

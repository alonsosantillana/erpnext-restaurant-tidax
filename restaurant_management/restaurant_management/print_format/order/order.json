 "font_size": 0,
 "html":"<style>\n    @page {\n        size: 80mm 300mm;\n        margin: 0;\n    }\n\n    html, body {\n        width: 80mm;\n        margin: 0;\n        padding: 0;\n        background: #fff;\n    }\n\n    .print-format {\n        box-sizing: border-box;\n        width: 80mm !important;\n        max-width: 80mm !important;\n        min-height: 0 !important;\n        margin: 0 !important;\n        padding: 3mm !important;\n        color: #000 !important;\n        background: #fff !important;\n        font-family: Arial, \"DejaVu Sans\", sans-serif !important;\n        font-size: 11pt !important;\n        line-height: 1.18 !important;\n    }\n\n    .print-format * {\n        box-sizing: border-box;\n        color: #000 !important;\n    }\n\n    .command-title {\n        text-align: center;\n        font-size: 16pt;\n        font-weight: 800;\n        margin-bottom: 1.5mm;\n    }\n\n    .command-company {\n        text-align: center;\n        font-size: 11pt;\n        font-weight: 700;\n        margin-bottom: 2mm;\n    }\n\n    .command-meta {\n        font-size: 10pt;\n        line-height: 1.25;\n        margin-bottom: 2mm;\n    }\n\n    .command-rule {\n        border: 0;\n        border-top: 0.35mm solid #000;\n        margin: 1.5mm 0;\n    }\n\n    .command-items {\n        width: 100%;\n        border-collapse: collapse;\n        table-layout: fixed;\n        margin: 0;\n    }\n\n    .command-items td {\n        padding: 2mm 0.5mm !important;\n        vertical-align: top !important;\n        border-bottom: 0.2mm dashed #000 !important;\n    }\n\n    .command-qty {\n        width: 18%;\n        text-align: center;\n        font-size: 18pt;\n        font-weight: 800;\n        line-height: 1;\n    }\n\n    .command-dish {\n        width: 82%;\n        font-size: 12pt;\n        font-weight: 800;\n        line-height: 1.15;\n        overflow-wrap: anywhere;\n    }\n\n    .command-code,\n    .command-center {\n        display: block;\n        margin-top: 0.7mm;\n        font-size: 8.5pt;\n        font-weight: 500;\n    }\n\n    .command-notes {\n        display: block;\n        margin-top: 1.2mm;\n        padding: 1.2mm;\n        border: 0.3mm solid #000;\n        font-size: 11pt;\n        font-weight: 800;\n        line-height: 1.15;\n    }\n\n    .command-comment {\n        margin-top: 2mm;\n        font-size: 11pt;\n        font-weight: 700;\n        overflow-wrap: anywhere;\n    }\n</style>\n\n{% set first_item = doc.entry_items[0] if doc.entry_items else none %}\n{% set waiter = frappe.db.get_value(\"User\", doc.cambio_mozo or doc.owner, \"full_name\") %}\n<div class=\"command-title\">{{ _(\"COMANDA\") }}</div>\n<div class=\"command-company\">{{ doc.company }}</div>\n<div class=\"command-meta\">\n    <b>{{ _(\"Orden\") }}:</b> {{ doc.name }}<br>\n    <b>{{ _(\"Mesa\") }}:</b> {{ doc.table_description or doc.context_label or \"\" }}<br>\n    {% if doc.room_description %}<b>{{ _(\"Ambiente\") }}:</b> {{ doc.room_description }}<br>{% endif %}\n    <b>{{ _(\"Mozo\") }}:</b> {{ waiter or doc.cambio_mozo or doc.owner }}<br>\n    {% if first_item and first_item.ordered_time %}\n        <b>{{ _(\"Hora\") }}:</b> {{ frappe.utils.get_datetime(first_item.ordered_time).strftime(\"%d/%m/%Y %H:%M\") }}\n        &nbsp; <b>{{ _(\"Ronda\") }}:</b> {{ first_item.ordered_nro }}\n    {% endif %}\n</div>\n<hr class=\"command-rule\">\n\n<table class=\"command-items\">\n    <tbody>\n        {% for item in doc.entry_items %}\n        <tr>\n            <td class=\"command-qty\">{{ item.qty }}</td>\n            <td class=\"command-dish\">\n                {{ item.item_name or item.item_code }}\n                {% if item.item_name and item.item_name != item.item_code %}\n                    <span class=\"command-code\">{{ item.item_code }}</span>\n                {% endif %}\n                {% if item.item_pt %}\n                    <span class=\"command-center\">{{ _(\"Centro\") }}: {{ item.item_pt }}</span>\n                {% endif %}\n                {% if item.notes %}\n                    <span class=\"command-notes\">{{ _(\"NOTA\") }}: {{ item.notes }}</span>\n                {% endif %}\n            </td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n\n{% if doc.comentario %}\n<div class=\"command-comment\">{{ _(\"Comentario\") }}: {{ doc.comentario }}</div>\n{% endif %}",
